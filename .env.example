# OpenDev API 配置（本文件不入库）
OPENDEV_API_KEY=your_opendev_api_key_here
OPENDEV_BASE_URL=https://api.openai-next.com/v1
OPENDEV_MODEL=claude-opus-5
# AnySearch MCP
ANYSEARCH_API_KEY=your_anysearch_api_key_here
# 星云数字人（可选，不填则页面不显示数字人按钮）
XINGYUN_APP_ID=your_xingyun_app_id_here
XINGYUN_APP_SECRET=your_xingyun_app_secret_here
